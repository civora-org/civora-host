#!/usr/bin/env bash
# Turns a fresh Debian/Ubuntu VPS into a host ready for the public demo
# (docs/ops/demo-server.md). Run once as root; safe to re-run.
#
#   SITE_ADDRESS=demo.civora.sk ACME_EMAIL=you@example.org bash demo-provision
#
# What it does: installs Docker (official repo) and the compose plugin, creates
# the `deploy` user, enables UFW (22, 80, 443), unattended security upgrades and
# a swap file on small machines, clones the host repository and prepares .env from .env.demo.example.
# It does not deploy: the next step is `bin/demo-deploy` as the deploy user.
#
# Environment (all optional; the repositories are public):
#   GITHUB_TOKEN        only for private forks: read access to the host repo and
#                       the engine repo
#   SITE_ADDRESS        public host name, written to .env
#   ACME_EMAIL          Let's Encrypt contact, written to .env
#   DEPLOY_USER         default: deploy
#   REPO_URL            default: https://github.com/civora-org/civora-host.git
#   REPO_REF            default: main
#   SSH_PORT            default: 22 (the port UFW keeps open for ssh)
#   INSTALL_RESET_CRON  1 = install the nightly demo reset (03:30 server time)
set -euo pipefail

DEPLOY_USER="${DEPLOY_USER:-deploy}"
REPO_URL="${REPO_URL:-https://github.com/civora-org/civora-host.git}"
REPO_REF="${REPO_REF:-main}"
SSH_PORT="${SSH_PORT:-22}"
INSTALL_RESET_CRON="${INSTALL_RESET_CRON:-0}"

log() { printf '==> %s\n' "$*"; }
die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }

[ "$(id -u)" -eq 0 ] || die "run as root (sudo)"
[ -r /etc/os-release ] || die "/etc/os-release missing; Debian or Ubuntu required"
# shellcheck disable=SC1091
. /etc/os-release
case "${ID:-}" in
  debian | ubuntu) ;;
  *) die "unsupported OS '${ID:-unknown}': Debian or Ubuntu required" ;;
esac

if [ -n "${SITE_ADDRESS:-}" ] && ! [[ "$SITE_ADDRESS" =~ ^[A-Za-z0-9.-]+$ ]]; then
  die "SITE_ADDRESS must be a bare host name (letters, digits, dots, dashes)"
fi
if [ -n "${ACME_EMAIL:-}" ] && ! [[ "$ACME_EMAIL" =~ ^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+$ ]]; then
  die "ACME_EMAIL does not look like an e-mail address"
fi

export DEBIAN_FRONTEND=noninteractive

log "1/9 Base packages"
apt-get update -qq
apt-get install -y -qq ca-certificates curl gnupg ufw unattended-upgrades git openssl cron util-linux >/dev/null

log "2/9 Docker Engine and the compose plugin"
if docker compose version >/dev/null 2>&1; then
  echo "    already installed: $(docker compose version)"
else
  install -m 0755 -d /etc/apt/keyrings
  curl -fsSL "https://download.docker.com/linux/${ID}/gpg" -o /etc/apt/keyrings/docker.asc
  chmod a+r /etc/apt/keyrings/docker.asc
  cat >/etc/apt/sources.list.d/docker.list <<DOCKER_LIST
deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/${ID} ${VERSION_CODENAME} stable
DOCKER_LIST
  apt-get update -qq
  apt-get install -y -qq docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin >/dev/null
fi
systemctl enable --now docker >/dev/null 2>&1 || true

log "3/9 Deploy user '${DEPLOY_USER}'"
if ! id "$DEPLOY_USER" >/dev/null 2>&1; then
  adduser --disabled-password --gecos "" "$DEPLOY_USER" >/dev/null
fi
usermod -aG docker "$DEPLOY_USER"
DEPLOY_HOME="$(getent passwd "$DEPLOY_USER" | cut -d: -f6)"
if [ -s /root/.ssh/authorized_keys ] && [ ! -s "$DEPLOY_HOME/.ssh/authorized_keys" ]; then
  install -d -m 700 -o "$DEPLOY_USER" -g "$DEPLOY_USER" "$DEPLOY_HOME/.ssh"
  install -m 600 -o "$DEPLOY_USER" -g "$DEPLOY_USER" /root/.ssh/authorized_keys "$DEPLOY_HOME/.ssh/authorized_keys"
  echo "    copied root's ssh keys to ${DEPLOY_USER}"
fi

log "4/9 Firewall (UFW: ssh ${SSH_PORT}, 80, 443)"
ufw default deny incoming >/dev/null
ufw default allow outgoing >/dev/null
ufw allow "${SSH_PORT}/tcp" >/dev/null
ufw allow 80/tcp >/dev/null
ufw allow 443/tcp >/dev/null
ufw allow 443/udp >/dev/null
ufw --force enable >/dev/null
echo "    note: Docker publishes ports around UFW; the demo stack publishes only Caddy (80/443)."

log "5/9 Unattended security upgrades"
cat >/etc/apt/apt.conf.d/20auto-upgrades <<'AUTO'
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";
APT::Periodic::AutocleanInterval "7";
AUTO

log "6/9 Swap (only when RAM is small and no swap exists)"
mem_kb="$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)"
if [ "$mem_kb" -lt 4500000 ] && [ -z "$(swapon --show --noheadings)" ]; then
  if [ ! -f /swapfile ]; then
    fallocate -l 2G /swapfile || dd if=/dev/zero of=/swapfile bs=1M count=2048 status=none
    chmod 600 /swapfile
    mkswap /swapfile >/dev/null
  fi
  swapon /swapfile
  grep -q '^/swapfile ' /etc/fstab || echo '/swapfile none swap sw 0 0' >>/etc/fstab
  echo "    2 GB swap enabled (RAM ${mem_kb} kB)"
else
  echo "    not needed or already present"
fi

log "7/9 Optional GitHub token (private forks only)"
TOKEN_DIR="$DEPLOY_HOME/.config/civora-demo"
TOKEN_FILE="$TOKEN_DIR/github-token"
if [ -n "${GITHUB_TOKEN:-}" ]; then
  install -d -m 700 -o "$DEPLOY_USER" -g "$DEPLOY_USER" "$DEPLOY_HOME/.config" "$TOKEN_DIR"
  (umask 077 && printf '%s\n' "$GITHUB_TOKEN" >"$TOKEN_FILE")
  chown "$DEPLOY_USER:$DEPLOY_USER" "$TOKEN_FILE"
  chmod 600 "$TOKEN_FILE"
  echo "    stored in $TOKEN_FILE"
else
  echo "    none (public repositories)"
fi

log "8/9 Clone the host repository"
APP_DIR="$DEPLOY_HOME/civora-host"
if [ -d "$APP_DIR/.git" ]; then
  echo "    already cloned: $APP_DIR"
elif [ -s "$TOKEN_FILE" ]; then
  auth="$(printf 'x-access-token:%s' "$(cat "$TOKEN_FILE")" | base64 -w0)"
  runuser -u "$DEPLOY_USER" -- env \
    GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=http.extraHeader \
    "GIT_CONFIG_VALUE_0=Authorization: Basic ${auth}" \
    git clone --branch "$REPO_REF" "$REPO_URL" "$APP_DIR" >/dev/null
  echo "    cloned $REPO_URL ($REPO_REF) with the token"
else
  runuser -u "$DEPLOY_USER" -- git clone --branch "$REPO_REF" "$REPO_URL" "$APP_DIR" >/dev/null
  echo "    cloned $REPO_URL ($REPO_REF) to $APP_DIR"
fi

log "9/9 .env"
ENV_FILE="$APP_DIR/.env"
if [ ! -f "$ENV_FILE" ]; then
  install -m 600 -o "$DEPLOY_USER" -g "$DEPLOY_USER" "$APP_DIR/.env.demo.example" "$ENV_FILE"
  echo "    created $ENV_FILE from .env.demo.example"
fi
set_env() { # KEY VALUE (values are validated above: no '|' or '&')
  if grep -q "^$1=" "$ENV_FILE"; then sed -i "s|^$1=.*|$1=$2|" "$ENV_FILE"; else printf '%s=%s\n' "$1" "$2" >>"$ENV_FILE"; fi
}
[ -z "${SITE_ADDRESS:-}" ] || set_env SITE_ADDRESS "$SITE_ADDRESS"
[ -z "${ACME_EMAIL:-}" ] || set_env ACME_EMAIL "$ACME_EMAIL"
chmod 600 "$ENV_FILE"

if [ "$INSTALL_RESET_CRON" = "1" ]; then
  cat >/etc/cron.d/civora-demo-reset <<CRON
# Nightly demo reset: drop and reseed (docs/ops/demo-server.md). Remove this file to stop it.
30 3 * * * ${DEPLOY_USER} cd ${APP_DIR} && bin/demo-deploy --reset --skip-build >>${DEPLOY_HOME}/demo-reset.log 2>&1
CRON
  chmod 644 /etc/cron.d/civora-demo-reset
  echo "    nightly reset installed: /etc/cron.d/civora-demo-reset"
fi

cat <<NEXT

Provisioning done. Next, as ${DEPLOY_USER}:
  ssh ${DEPLOY_USER}@<this server>
  cd civora-host
  nano .env            # SITE_ADDRESS, ACME_EMAIL, DEMO_ADMIN_EMAIL
  bin/demo-deploy
(Log out and in once if \`docker\` says permission denied: the group change needs a new login.)
NEXT
