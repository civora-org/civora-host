# Environment for the PUBLIC DEMO server. bin/demo-deploy copies this file to
# .env on first run, generates the two secrets below and then asks you to fill
# the rest. Never commit .env. Guide: docs/ops/demo-server.md
#
# DEMO DATA ONLY: nothing real may ever be put on this server.

# Marks the stack as a demo. bin/demo-deploy and the seed tasks refuse to run
# without it. Keep it at 1.
DEMO_MODE=1

# Compose files for the demo stack (base + TLS terminator + demo overlay).
COMPOSE_FILE=compose.yaml:compose.tls.yml:compose.demo.yml

# --- Domain and TLS --------------------------------------------------------
# Public host name (no scheme). Create an A record for it pointing at the VPS
# BEFORE the first deploy, otherwise Let's Encrypt cannot issue a certificate.
# Caddy serves it, and the demo overlay makes it the organization's host.
SITE_ADDRESS=demo.civora.sk
# Contact address Let's Encrypt uses for expiry notices.
ACME_EMAIL=you@example.org

# --- Generated secrets (filled by bin/demo-deploy when empty) --------------
# openssl rand -hex 64
SECRET_KEY_BASE=
# openssl rand -hex 16. Do not change it once the database volume exists.
POSTGRES_PASSWORD=

# --- Demo admin ------------------------------------------------------------
# E-mail of the demo admin. The password is generated by bin/demo-deploy and
# written to a 600-mode file on the server (see DEMO_CREDENTIALS_FILE in the
# guide); it is never stored in this file.
DEMO_ADMIN_EMAIL=demo-admin@example.org

# --- Mail ------------------------------------------------------------------
# All outgoing mail is written to files inside the container (DEMO_MODE), so
# no SMTP_* variable is needed or wanted. From address shown in those mails:
DECIDIM_MAILER_SENDER=demo-noreply@example.org

# --- Never set on the demo -------------------------------------------------
# CRZ_ICO_ORG_*          would scope a sync to a real IČO; the scheduler is
#                        disabled and these must stay unset
# SMTP_*                 real mail delivery
# SENTRY_DSN, ALERT_*    observability is not part of the demo stack
# GITHUB_TOKEN           lives outside the repository directory, see the guide
#                        (it must not reach the app container environment)
