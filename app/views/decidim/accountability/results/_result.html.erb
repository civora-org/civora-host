<%# Civora host override of decidim-accountability 0.32.1 app/views/decidim/accountability/results/_result.html.erb.
    Verbatim gem copy plus ONE added line (marked "Civora"): the engine's related-contracts
    block (civora-org/civora-platform#131, decidim-contracts_sk docs/related-contracts.md).
    On a Decidim upgrade: diff this file against the gem and re-apply the line. %>
<%= render layout: "layouts/decidim/shared/layout_item" do %>
  <%= cell("decidim/accountability/result_show", result) %>
  <%= cell("decidim/tags", result) %>
  <%= render partial: "decidim/contracts_sk/related_contracts/list", locals: { resource: result } %> <%# Civora %>

  <section class="layout-main__section layout-main__buttons" data-buttons>
    <%= cell "decidim/comments_button", nil %>
  </section>

  <% content_for :aside do %>
    <section class="layout-aside__section layout-aside__buttons accountability__result-aside">
      <% if component_settings.display_progress_enabled? %>
        <%= cell(
          "decidim/accountability/status",
          result,
          title: t("models.result.fields.progress", scope: "decidim.accountability"),
          extra_classes: "accountability__status__result"
        ) %>
      <% end %>

    <%= cell("decidim/accountability/result_metadata", result, template: :result_aside) %>
    </section>
  <% end %>
  <% content_for :item_footer do %>
    <%= comments_for result %>
    <%= cell "decidim/accountability/result_metadata", result, template: :show_footer %>
  <% end %>
<% end %>
