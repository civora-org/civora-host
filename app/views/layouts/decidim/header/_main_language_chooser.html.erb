<%# Host override of decidim-core's header language chooser (0.32.2). The desktop
    header is full between 1024px and 1440px, so the trigger can show the locale
    code ("SK") there while the dropdown keeps the full names; the full name
    stays in the markup for assistive technology and for the mobile menu, which
    renders this same partial. Drift: the gem partial plus one block marked
    "Civora" (test/integration/header_override_drift_test.rb). %>
<% if available_locales.length > 1 %>
  <div class="main-bar__language-chooser">
    <button id="trigger-<%= id %>" data-controller="dropdown" data-target="<%= id %>" class="main-bar__language-chooser-trigger">
      <span class="main-bar__language-chooser-holder">
        <%= icon "global-line" %>
        <%# Civora: start %>
        <span class="civora-locale-code" aria-hidden="true"><%= locale.to_s.upcase %></span>
        <span class="civora-locale-name"><%= t("name", scope: "locale" ) %></span>
        <%# Civora: end %>
      </span>
      <%= icon "arrow-down-s-line" %>
      <span class="sr-only" lang="<%= locale %>">
        <%= t("layouts.decidim.language_chooser.choose_language") %>
      </span>
    </button>

    <div id="<%= id %>" aria-hidden="true">
      <ul class="main-bar__language-chooser-list" role="menu">
        <% available_locales.each do |locale| %>
          <li class="<%= I18n.locale.to_s == locale ? "main-bar__language-chooser-item-active" : "main-bar__language-chooser-item" %>" role="presentation">
            <%= link_to locale_name(locale), decidim.locale_path(locale:), method: :post, role: "menuitem", lang: locale, class: "p-2 w-full block" %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
<% end %>
