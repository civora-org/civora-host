# Copy to .env and fill in. Never commit .env.
# Full inventory and policy: docs/ops/secrets.md

# Required
SECRET_KEY_BASE=
POSTGRES_PASSWORD=

# Host the seeded organization answers on (db/seeds.rb); defaults to
# localhost. Set it to the pilot domain before the first boot.
# DECIDIM_ORG_HOST=zmluvy.example.sk

# Docker build, optional: only for private forks (token with Contents: read on the engine repository).
# Leave empty for the public repositories.
# (passed as a BuildKit secret mount, never stored in the image)
GITHUB_TOKEN=

# Production mail (SMTP) — unconfigured yet; wire at first real deploy.
# Read by config/environments/production.rb via Decidim::Env.
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_AUTHENTICATION=plain
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_DOMAIN=

# TLS terminator (compose.tls.yml, docs/ops/tls.md) — REQUIRED for anything
# public. Add compose.tls.yml to COMPOSE_FILE and set all three; DECIDIM_ORG_HOST
# (above) must equal SITE_ADDRESS.
# COMPOSE_FILE=compose.yaml:compose.tls.yml
# SITE_ADDRESS=zmluvy.example.sk
# ACME_EMAIL=ops@example.sk

# Backups (scripts/backup.sh, docs/ops/restore-runbook.md, docs/ops/secrets.md) —
# REQUIRED before any real data. age public keys only: the private keys never
# go on the server. Keep two recipients (operator + offline escrow).
# BACKUP_STRICT=1
# BACKUP_AGE_RECIPIENTS=age1... age1...
# BACKUP_RETENTION_DAYS=30
# S3-compatible bucket at a DIFFERENT provider/account than this server:
# BACKUP_OFFSITE_BUCKET=
# BACKUP_OFFSITE_PREFIX=civora/zmluvy-obec-sk     (one prefix per city)
# BACKUP_OFFSITE_ENDPOINT=https://s3.example-provider.eu
# BACKUP_OFFSITE_REGION=
# BACKUP_OFFSITE_PROVIDER=Other
# BACKUP_OFFSITE_ACCESS_KEY_ID=
# BACKUP_OFFSITE_SECRET_ACCESS_KEY=
# BACKUP_OFFSITE_PRUNE=1                          (0 = bucket lifecycle rule expires old backups)
# BACKUP_TOOLS_IMAGE=civora-backup-tools:1        (age + rclone image, built on first use)
# BACKUP_TOOLS_DOCKER_ARGS=
# Restore time only, on YOUR machine, never on the server:
# BACKUP_AGE_IDENTITY_FILE=/path/to/age.key

# Observability (compose.observability.yml) — see docs/ops/observability.md.
# Include the overlay in every `docker compose` command by pinning COMPOSE_FILE
# (ops scripts default to the overlay whenever the file exists and this is unset):
# COMPOSE_FILE=compose.yaml:compose.observability.yml
# (one COMPOSE_FILE line only: with TLS too, compose.yaml:compose.tls.yml:compose.observability.yml)
# Required when the observability overlay is used:
GLITCHTIP_SECRET_KEY=
GLITCHTIP_DB_PASSWORD=
# Optional:
# GLITCHTIP_DOMAIN=http://localhost:8080
# SENTRY_DSN=            (GlitchTip project DSN; Sentry disabled when unset)
# PUSHGATEWAY_URL=http://127.0.0.1:9091
# Alert delivery (Alertmanager) — urgent (critical/high) → Telegram, all → e-mail:
# ALERT_TELEGRAM_BOT_TOKEN=     (from @BotFather)
# ALERT_TELEGRAM_CHAT_ID=       (your chat id with the bot, a number)
# ALERT_EMAIL_TO=
# ALERT_SMTP_USERNAME=          (Google Workspace mailbox; also the From address)
# ALERT_SMTP_PASSWORD=          (Google app password, not the account password)
# ALERT_SMTP_SMARTHOST=smtp.gmail.com:587

# CRZ import scope (civora-org/civora-platform#145) — REQUIRED per organization
# for the sync to run: the municipality's IČO, keyed by organization id. Only
# contracts with this IČO on either party are imported.
# CRZ_ICO_ORG_1=00313271

# CRZ nightly sync (scheduler service, docs/ops/crz-sync.md) — all optional:
# First-run cursor for organizations without state (default: 7 days ago)
# CRZ_SYNC_INITIAL_SINCE=2026-09-01T00:00:00Z
# Dead-man push target (default: the in-network pushgateway)
# CRZ_SYNC_PUSHGATEWAY_URL=http://pushgateway:9091
# Pin the audit/authorship admin (default: first admin with accepted terms)
# ACTOR_EMAIL=
