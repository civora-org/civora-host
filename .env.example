# Copy to .env and fill in. Never commit .env.
# Full inventory and policy: docs/ops/secrets.md

# Required
SECRET_KEY_BASE=
POSTGRES_PASSWORD=

# Docker build only: token with read access to civora-org/decidim-contracts_sk
# (passed as a BuildKit secret mount, never stored in the image)
GITHUB_TOKEN=

# Production mail (SMTP) — unconfigured yet; wire at first real deploy.
# Read by config/environments/production.rb via Decidim::Env.
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_AUTHENTICATION=plain
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_DOMAIN=

# Observability (compose.observability.yml) — see docs/ops/observability.md.
# Include the overlay in every `docker compose` command by pinning COMPOSE_FILE
# (ops scripts default to the overlay whenever the file exists and this is unset):
# COMPOSE_FILE=compose.yaml:compose.observability.yml
# Required when the observability overlay is used:
GLITCHTIP_SECRET_KEY=
GLITCHTIP_DB_PASSWORD=
# Optional:
# GLITCHTIP_DOMAIN=http://localhost:8080
# SENTRY_DSN=            (GlitchTip project DSN; Sentry disabled when unset)
# PUSHGATEWAY_URL=http://127.0.0.1:9091
# ALERT_WEBHOOK_URL=
